{
  "name": "medguide",
  "version": "1.0.0",
  "description": "MedGuide - Complete Healthcare Management System",
  "main": "index.js",
  "scripts": {
    "install-backend": "cd backend && npm install",
    "install-frontend": "cd frontend && npm install",
    "install-all": "npm run install-backend && npm run install-frontend",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run backend\" \"npm run frontend\"",
    "build-frontend": "cd frontend && npm run build",
    "start-backend": "cd backend && npm start",
    "start-frontend": "cd frontend && npm run preview",
    "start": "concurrently \"npm run start-backend\" \"npm run start-frontend\""
  },
  "keywords": [
    "healthcare",
    "medical",
    "appointment",
    "prescription",
    "doctor",
    "patient",
    "hospital",
    "clinic",
    "telemedicine"
  ],
  "author": "MedGuide Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/medguide.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/medguide/issues"
  },
  "homepage": "https://github.com/yourusername/medguide#readme"
}